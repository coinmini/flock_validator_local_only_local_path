# ============================================================
# Mode 1: FLock platform proxy (default client, single key)
# All eval models in --eval-model-list are routed through this.
# ============================================================
OPENAI_BASE_URL=https://api.flock.io/v1
OPENAI_API_KEY=

# ============================================================
# Mode 2: Direct provider clients (per-prefix registration)
# Any <PREFIX>_MODELS + <PREFIX>_BASE_URL + <PREFIX>_API_KEY trio
# registers those models to that provider's endpoint.
# Models listed here take priority over the default client.
# Both modes can coexist; unmatched models fall back to OPENAI_*.
# Optional: <PREFIX>_MODEL_MAP=local-name:actual-api-name
# ============================================================
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-v4-pro

# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_API_KEY=
# MOONSHOT_MODELS=kimi-k2.6

# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash
